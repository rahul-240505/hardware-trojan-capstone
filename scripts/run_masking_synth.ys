# --- A. CLEAN BASELINE SYNTHESIS ---
read_verilog rtl/sensor_clean.v
hierarchy -check -top sensor_node
proc; opt -full; techmap; opt -fast
dfflibmap -liberty lib/NangateOpenCellLibrary_typical.lib
abc -liberty lib/NangateOpenCellLibrary_typical.lib
opt_clean -purge
write_verilog -noattr netlist/clean_synth.v
design -reset

# --- B. UNOPTIMIZED TROJAN SYNTHESIS (No Flattening / Redundant Gates Preserved) ---
read_verilog rtl/sensor_trojan.v
hierarchy -check -top sensor_node
proc; techmap
dfflibmap -liberty lib/NangateOpenCellLibrary_typical.lib
abc -liberty lib/NangateOpenCellLibrary_typical.lib
write_verilog -noattr netlist/trojan_unopt_synth.v
design -reset

# --- C. AGGRESSIVELY OPTIMIZED TROJAN SYNTHESIS (Synthesis-Masking Active) ---
read_verilog rtl/sensor_trojan.v
hierarchy -check -top sensor_node
proc; flatten; opt -full; share -aggressive; wreduce; peepopt; techmap; opt -fast
dfflibmap -liberty lib/NangateOpenCellLibrary_typical.lib
abc -liberty lib/NangateOpenCellLibrary_typical.lib -dff
opt_clean -purge
write_verilog -noattr netlist/trojan_masked_synth.v
